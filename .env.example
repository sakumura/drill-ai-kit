# juken-ai-kit 環境変数の見本
# `cp .env.example .env` して自分の値を入れる（.env は gitignore 済み）
# シェルで使う場合: `set -a && source .env && set +a`

# --- Cloudflare（必須） ---
# アカウントID: Cloudflare ダッシュボード右下、または `npx wrangler whoami`
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# APIトークン: R2 の読み取り権限（Object Read）を持つトークン。
# scripts/pull_r2_play_log.py（プレイログ取得）が使用する。
# 作成: ダッシュボード > My Profile > API Tokens > Create Token
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# --- R2（任意。既定値: juken-ai-kit-play-log） ---
# workers/wrangler.jsonc の bucket_name と一致させること
R2_BUCKET=juken-ai-kit-play-log

# --- API access controls（実運用では設定推奨） ---
# Worker secrets に同じ値を設定する:
#   cd workers && npx wrangler secret put API_WRITE_TOKEN
#   cd workers && npx wrangler secret put API_READ_TOKEN
# VITE_* はブラウザ配信 bundle に含まれるため、強い認証ではありません。
# 公開URLを広く共有する場合は Cloudflare Access 等を併用してください。
VITE_API_WRITE_TOKEN=
VITE_API_READ_TOKEN=

# --- 本番スモークテスト（任意。デプロイ後に設定） ---
# 自分の Cloudflare Pages / Workers の公開URL
PROD_URL=https://YOUR-PROJECT.pages.dev
PROD_API_URL=https://juken-ai-kit-api.YOUR-SUBDOMAIN.workers.dev
